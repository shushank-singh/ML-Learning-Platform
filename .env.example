# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Supabase Server Service Role (Server-side only — never expose to client!)
# SUPABASE_SERVICE_ROLE_KEY

# Owner & Entitlement Configuration (Server-side only)
# Set this to the authenticated owner's Supabase User ID (UUID) or verified email
# AZURLEARN_OWNER_ID=
# AZURLEARN_OWNER_EMAIL=

# Razorpay Payment Gateway Configuration
# Key ID is public for Razorpay Checkout Modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_ID=rzp_test_placeholder
# Server-side only Razorpay secrets (never prefix with NEXT_PUBLIC_)
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MONTHLY_PLAN_ID=plan_placeholder

# Track Pricing Overrides (Server-side only, integer in paise; e.g. 499900 = ₹4,999)
# TRACK_PRICE_ML_LIFETIME_PAISE=
# TRACK_PLAN_ML_MONTHLY_ID=
